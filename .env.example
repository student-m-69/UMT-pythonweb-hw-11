# Copy to .env and fill in. Nothing from this file is committed except the example.

# PostgreSQL. POSTGRES_PASSWORD feeds docker-compose; DATABASE_URL feeds the app
# when it runs on the host (inside compose the URL is derived automatically).
POSTGRES_PASSWORD=hw11secret
DATABASE_URL=postgresql+psycopg2://postgres:hw11secret@localhost:5432/contacts_app

# JWT. Generate the key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP for the verification email. Leave MAIL_SERVER empty to have the app log
# the confirmation link instead of sending it (handy for local testing).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_FROM_NAME=Contacts API

# Cloudinary for avatar uploads (dashboard -> account details).
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
